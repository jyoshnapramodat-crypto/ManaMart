# ==============================================================================
# MANAMART — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime
PORT=5050
NODE_ENV=development

# Web Frontend URL (CORS & Socket allowlist)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas in Production, or local daemon)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/manamart?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/localloop_manamart

# In-Memory Development Store Toggle (Only for local testing without MongoDB)
# Set to 'true' only for local mock development. Never set to true in production!
USE_MOCK_DB=false

# JSON Web Token Secrets (Generate strong random 64-char strings in production)
JWT_SECRET=super_secret_jwt_key_localloop_2026_dev
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_localloop_2026_dev
REFRESH_TOKEN_EXPIRES_IN=30d

# Cloud Document & Media Storage (Cloudinary - Optional)
# If left empty, secure restricted server storage (/uploads) is utilized automatically
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay - Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Dispatch (Nodemailer SMTP - Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@manamart.in

# SMS / OTP Gateway (Twilio / Fast2SMS - Optional)
SMS_API_KEY=
